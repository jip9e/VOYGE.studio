# --- Required -----------------------------------------------------------

# Mapbox -- map rendering, geocoding, route optimization
# Get yours at: https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# RapidAPI -- Instagram & TikTok scraping
# Subscribe to: https://rapidapi.com/
RAPIDAPI_KEY=your_rapidapi_key_here

# --- AI / Intelligence ---------------------------------------------------

# GitHub Models / Azure AI (GPT-4o) -- location AI agent + spot enhancement
# Get yours at: https://github.com/marketplace/models
GITHUB_MODELS_TOKEN=ghp_your_github_models_token_here

# Google Cloud Vision -- landmark detection from thumbnails (optional)
# Enable at: https://console.cloud.google.com/apis/library/vision.googleapis.com
GOOGLE_VISION_KEY=your_google_vision_api_key_here

# Google Knowledge Graph -- place verification (optional)
# Enable at: https://console.cloud.google.com/apis/library/kgsearch.googleapis.com
GOOGLE_KG_API_KEY=your_google_kg_api_key_here

# --- Geocoding Fallbacks (all optional) ---------------------------------

# GeoNames -- free geocoding fallback (requires free account signup)
# Register at: https://www.geonames.org/login
GEONAMES_USERNAME=your_geonames_username

# HERE Geocoding -- paid fallback geocoder (optional)
# Get yours at: https://developer.here.com/
HERE_API_KEY=your_here_api_key_here

# OpenCage Geocoding -- paid fallback geocoder (optional)
# Get yours at: https://opencagedata.com/
OPENCAGE_API_KEY=your_opencage_api_key_here

# --- Media ---------------------------------------------------------------

# Pexels -- high-quality travel images for spots (optional)
# Get yours at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# --- Integrations --------------------------------------------------------

# Telegram Bot -- forward reels/tiktoks via Telegram (optional)
# Create a bot at: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
