# ─── Dependencies ─────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js ──────────────────────────────────────────────────────────────────
/.next/
/out/
/build

# ─── Environment Variables ────────────────────────────────────────────────────
# All .env files are ignored EXCEPT .env.example (safe to commit — no real secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
# Do NOT ignore .env.example — it is a template with no real keys

# ─── Vercel ───────────────────────────────────────────────────────────────────
.vercel

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Testing ──────────────────────────────────────────────────────────────────
/coverage

# ─── OS / Editor ──────────────────────────────────────────────────────────────
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.idea/
.vscode/settings.json
